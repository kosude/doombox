; *****************************************************************************
; video.pio
; Time-critical driver to output RGB digital signals to the parallel RGB GPIOs,
; as paced by the V-sync driver.
; Unlike the timing signal generators, this program runs in a max-frequency
; state machine (150 MHz) instead of a divided clock.
; *****************************************************************************

.program video

; pulls the number of pixels per line from the core
    pull    block
    mov     x, osr                  ; pixel count per line persists in x

.wrap_target

; video output
vout:
    ; in blanking region up until wait
    mov     osr, null
    out     pins, 8                 ; clear pins during blanking
    mov     y, x

    wait    1 irq 1                 ; wait until next active region line

    ; ~12 cycles needed per pixel to fill screen w/ 320 width
_vout_loop:
    pull    block                   ; pull next 8-bit colour value from DMA
    out     pins, 8 [9]             ; push pixel to GPIOs
    jmp     y-- _vout_loop          ; loop through active line

.wrap

; *****************************************************************************

% c-sdk {
static inline void
video_program_init(PIO pio,
                   uint8_t sm,
                   uint8_t offset,
                   uint8_t gpio_b2g3r3_base)
{
    pio_sm_config cfg = video_program_get_default_config(offset);

    sm_config_set_out_pins(&cfg, gpio_b2g3r3_base, 8);

    // all pins output
    pio_sm_set_consecutive_pindirs(pio, sm, gpio_b2g3r3_base, 8, true);

    // make TX FIFO 8-bit, RX is disabled
    sm_config_set_fifo_join(&cfg, PIO_FIFO_JOIN_TX);

    // init all pins
    for (uint8_t i = 0; i < 8; i++) {
        pio_gpio_init(pio, gpio_b2g3r3_base + i);
    }

    // load config and jump to offset (start of program)
    pio_sm_init(pio, sm, offset, &cfg);
}
%}
